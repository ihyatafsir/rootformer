+# WIRED: Sibawayh's al-iktifa' -- a valency slot closes either by being filled, by being
+# licitly absent (lazim), or by being SATURATED BY A CLITIC.  Without it the stack keeps
+# awaiting a ma'mul that will never come and mis-assigns whatever follows.  The clitic is
+# already in the (prefix, root, wazn, SUFFIX) tuple, so saturation is computable here.
+try:
+    from iktifa_apocope import IktifaSaturation
+except Exception:                                            # pragma: no cover
+    IktifaSaturation = None
+
+
+def iktifa_slot(suffix, host_class):
+    """Which slot the attached pronoun saturates, or None (Sibawayh, al-Kitab)."""
+    if IktifaSaturation is None:
+        return None
+    try:
+        return IktifaSaturation.saturates(suffix, host_class)
+    except Exception:
+        return None
+
